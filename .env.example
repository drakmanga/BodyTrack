# Copy this file to .env and fill in real values before running docker-compose.prod.yml.
# Never commit the real .env file.

DB_NAME=bodytrack
DB_USER=bodytrack
DB_PASSWORD=change-me-to-a-strong-password

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long
JWT_EXPIRATION_MINUTES=1440

# Must match the origin the frontend is served from (no wildcard in production)
CORS_ALLOWED_ORIGIN=https://bodytrack.example.com

BACKEND_PORT=8080
